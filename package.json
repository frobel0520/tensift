{
  "name": "tensift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A multilingual hidden-rule grouping puzzle.",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts --configLoader runner",
    "build": "npm run validate:puzzles && npm run typecheck && vite build --config vite.config.ts --configLoader runner && node scripts/flatten-vite-output.mjs",
    "preview": "vite preview --config vite.config.ts --configLoader runner",
    "typecheck": "tsc -p tsconfig.json --pretty false && tsc -p tsconfig.node.json --pretty false",
    "test": "vitest run --config vitest.config.ts --configLoader runner",
    "validate:puzzles": "node --experimental-strip-types scripts/validate-puzzles.ts",
    "seed:puzzles": "node --experimental-strip-types scripts/seed-puzzles.ts",
    "db:migrate:local": "wrangler d1 migrations apply tensift --local",
    "db:migrate:remote": "wrangler d1 migrations apply tensift --remote",
    "db:seed:local": "node --experimental-strip-types scripts/seed-puzzles.ts --database tensift --local",
    "db:seed:remote": "node --experimental-strip-types scripts/seed-puzzles.ts --database tensift --remote",
    "scan:bundle": "node scripts/scan-public-bundle.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "check:runway": "node scripts/check-content-runway.mjs",
    "cf:dev": "wrangler pages dev dist",
    "cf:deploy": "wrangler pages deploy dist"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.34.0"
  }
}
